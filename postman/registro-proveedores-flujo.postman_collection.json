              "    pm.response.to.have.status(201);",
              "    pm.expect(pm.response.json().status).to.eql('IN_PROGRESS');",
              "});",
              "pm.collectionVariables.set('registrationId', pm.response.json().id);",
              "goTo('06 Cargar cédula fiscal');"
            ]
