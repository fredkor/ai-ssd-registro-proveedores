    {
      "name": "04 Consultar existencia del expediente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// pm.execution.setNextRequest solo existe en versiones recientes; postman.setNextRequest, en todas.",
              "const goTo = name => pm.execution && typeof pm.execution.setNextRequest === 'function'",
              "    ? pm.execution.setNextRequest(name) : postman.setNextRequest(name);",
              "pm.test('200 con la existencia del expediente', () => pm.response.to.have.status(200));",
              "const existence = pm.response.json();",
              "if (existence.exists && existence.status === 'IN_PROGRESS') {",
              "    // La base de desarrollo es duradera: el RFC del fixture ya tiene expediente y se reanuda.",
              "    pm.collectionVariables.set('registrationId', existence.registrationId);",
              "    goTo('05b Reanudar expediente existente');",
              "} else if (existence.exists) {",
              "    pm.test('El expediente no está REGISTERED', () => pm.expect(existence.status).to.eql('IN_PROGRESS'));",
              "    goTo(null);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/supplier-registrations/existence",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "supplier-registrations",
            "existence"
          ]
        }
