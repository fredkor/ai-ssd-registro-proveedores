              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.identity.rfc).to.eql('AAA010101AAA');",
              "    pm.expect(body.identity.taxRegime).to.eql('LEGAL_ENTITY');",
              "    pm.collectionVariables.set('registrationToken', body.registrationToken);",
              "});"
            ]
          }
        }
